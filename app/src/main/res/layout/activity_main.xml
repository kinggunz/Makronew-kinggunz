<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- ===================== KOLOM KIRI: identitas, status, kecepatan, mulai ===================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Makro by Gunz"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Status Aktivasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvStatusAksesibilitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status Aktivasi: belum aktif"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnAktivasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aktifkan Aksesibilitas"
                android:textSize="12sp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/white"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnKecepatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atur Kecepatan Ketuk"
            android:textSize="12sp"
            android:backgroundTint="#33FFFFFF"
            android:textColor="@color/white"
            android:layout_marginBottom="14dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnMulai"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mulai"
            android:textSize="15sp"
            android:backgroundTint="@color/confirm_green"
            android:textColor="@color/white"
            android:enabled="false"/>

    </LinearLayout>

    <!-- Pemisah -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#22FFFFFF"/>

    <!-- ===================== KOLOM KANAN: daftar aplikasi target ===================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aplikasi Target"
            android:textColor="@color/grey_text"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Double tap tombol mengambang = mulai/berhenti ketuk cepat. Ketukan tetap jalan meski jari dilepas, jadi layar bebas dipakai kapan saja."
            android:textColor="@color/grey_text"
            android:textSize="10sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</LinearLayout>
